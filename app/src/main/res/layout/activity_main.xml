<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Horizontal guideline dividing Top 16:9 screen and Bottom 1240:1080 + sidebars -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splitGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.53" />

    <!-- Top Half: 16:9 Screen pinned to top-center -->
    <FrameLayout
        android:id="@+id/topScreenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#08080A"
        app:layout_constraintBottom_toTopOf="@id/splitGuideline"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.aynthor.simulator.input.DisplaySurfaceView
            android:id="@+id/topSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Built-in Filterable App Launcher Overlay -->
        <LinearLayout
            android:id="@+id/launcherOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EE0B0B0F"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/launcherTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/launcher_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleShowAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/show_filtered_apps"
                    android:textColor="#D0D0D8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFilterApps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/filter_apps"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="true" />
        </LinearLayout>

        <!-- Shizuku Permission / Status Overlay -->
        <LinearLayout
            android:id="@+id/shizukuOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F208080A"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/shizukuStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/shizuku_waiting"
                android:textColor="#F0F0F5"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnShizukuAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/grant_shizuku" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom-Center: AYN Thor Secondary 1240x1080 Screen -->
    <FrameLayout
        android:id="@+id/bottomScreenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#08080A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1240:1080"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splitGuideline">

        <com.aynthor.simulator.input.DisplaySurfaceView
            android:id="@+id/bottomSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom Screen Icon App Launcher Overlay -->
        <LinearLayout
            android:id="@+id/bottomLauncherOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EE0B0B0F"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bottom Screen Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseBottomApp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Close App"
                    android:textColor="#EF4444"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnCancelBottomLauncher"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Done"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bottomAppRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- Left Sidebar (Utility Icons + Left Virtual Gamepad) -->
    <LinearLayout
        android:id="@+id/leftSidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomScreenContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splitGuideline">

        <!-- Left Utility Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnHome"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Launcher / Home"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnSwap"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Swap Screens"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnLaunchBottom"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Launch on Bottom"
                android:src="@android:drawable/ic_menu_add"
                android:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnCloseBottom"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Bottom App"
                android:src="@android:drawable/ic_delete"
                android:tint="#9CA3AF" />

            <TextView
                android:id="@+id/btnToggleLeftStick"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="#1A1A20"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="D/LS"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Left Virtual Gamepad -->
        <LinearLayout
            android:id="@+id/leftGamepadContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.aynthor.simulator.input.VirtualButtonView
                    android:id="@+id/btnL2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1" />

                <com.aynthor.simulator.input.VirtualButtonView
                    android:id="@+id/btnL1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.aynthor.simulator.input.VirtualDpadView
                    android:id="@+id/virtualDpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.aynthor.simulator.input.VirtualThumbstickView
                    android:id="@+id/virtualLeftStick"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

            <com.aynthor.simulator.input.VirtualButtonView
                android:id="@+id/btnSelect"
                android:layout_width="96dp"
                android:layout_height="32dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Sidebar (Utility Icons + Right Virtual Gamepad) -->
    <LinearLayout
        android:id="@+id/rightSidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottomScreenContainer"
        app:layout_constraintTop_toBottomOf="@id/splitGuideline">

        <!-- Right Utility Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToggleRightStick"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp"
                android:background="#1A1A20"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="ABXY/RS"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDebugLog"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Debug Log"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnToggleTouch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Touch Controls"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#9CA3AF" />

            <ImageButton
                android:id="@+id/btnExit"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Stop / Exit"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#EF4444" />
        </LinearLayout>

        <!-- Right Virtual Gamepad -->
        <LinearLayout
            android:id="@+id/rightGamepadContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.aynthor.simulator.input.VirtualButtonView
                    android:id="@+id/btnR1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1" />

                <com.aynthor.simulator.input.VirtualButtonView
                    android:id="@+id/btnR2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.aynthor.simulator.input.VirtualFaceButtonsView
                    android:id="@+id/virtualFaceButtons"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.aynthor.simulator.input.VirtualThumbstickView
                    android:id="@+id/virtualRightStick"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

            <com.aynthor.simulator.input.VirtualButtonView
                android:id="@+id/btnStart"
                android:layout_width="96dp"
                android:layout_height="32dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
